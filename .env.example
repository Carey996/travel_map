# ============================================================
#  Travel Blog - 环境变量示例
#  复制为 .env 后按需修改；.env 已被 .gitignore 忽略
# ============================================================

# ---- 运行环境 ----
ENVIRONMENT=dev
# 监听地址。默认只监听回环，本地开发与单 Pod 验证都用这个值；
# 容器化部署（API 与 web 分属两个容器/Pod）必须改成 0.0.0.0
API_HOST=127.0.0.1
API_PORT=8000

# ---- 数据库（Postgres）----
# 两种驱动前缀都支持，Go 版会自动归一化：
#   postgres://user:pass@host:port/db?sslmode=disable   （Go / pgx 原生）
#   postgresql+asyncpg://user:pass@host:port/db         （SQLAlchemy 风格）
DATABASE_URL=postgres://travelblog:travelblog@127.0.0.1:5432/travelblog

# ---- Redis（session 存储）----
REDIS_URL=redis://127.0.0.1:16379/0
# redis = session 存 Redis（默认，支持即时撤销）
# db    = session 回落 Postgres，便于零容器启动
SESSION_BACKEND=redis

# ---- 会话 Cookie ----
SESSION_COOKIE_NAME=tb_session
SESSION_TTL_SECONDS=2592000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- 对象存储（MinIO / S3 兼容）----
# 后端调用用的地址
S3_ENDPOINT_URL=http://127.0.0.1:9000
# 浏览器直传用的地址；留空则复用 S3_ENDPOINT_URL
S3_PUBLIC_ENDPOINT_URL=
# 两个 TLS 开关，本地开发都是 false（MinIO 走明文 http）。
# 部署到公网时常见形态是「后端走内网 http、浏览器走对外 https」，这时必须分开设：
#   S3_ENDPOINT_URL=http://minio:9000               S3_USE_SSL=false
#   S3_PUBLIC_ENDPOINT_URL=https://img.example.com  S3_PUBLIC_USE_SSL=true
# minio-go 要求地址里的协议与开关严格一致，不一致时启动就会失败并点名是哪个变量。
S3_USE_SSL=false
# 不写时跟随 S3_USE_SSL
S3_PUBLIC_USE_SSL=false
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=travelblog
S3_REGION=us-east-1
S3_PRESIGN_EXPIRES=3600

# ---- CORS（前端来源，逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 地理编码（后端代理，不落盘缓存）----
# photon    = OSM 数据、免 key、原生中文（默认；国内网络可达）
# nominatim = OSM 官方服务（国内网络通常不可达）
GEOCODE_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=travel-blog/0.1 (personal project)
NOMINATIM_LANGUAGE=zh-CN,zh,en
