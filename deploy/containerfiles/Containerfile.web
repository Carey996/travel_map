# 前端镜像：构建 SPA 后用 nginx 提供服务。
#
# 构建上下文是**仓库根目录**：
#   podman build -f deploy/containerfiles/Containerfile.web -t travel-blog-web:dev .
FROM node:22-alpine AS builder

WORKDIR /src
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
# 注意：构建产物要与 API 同源，因此不设 VITE_API_BASE_URL——
# 请求走相对路径 /api，由下面的 nginx 反代到后端。
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
ENV API_UPSTREAM=travel-blog-api:8000
COPY --from=builder /src/dist /usr/share/nginx/html

# 与 nginx 模板的 listen 端口保持一致（非 root 运行不能绑 80）
EXPOSE 8080
