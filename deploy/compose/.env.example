# 单机 Compose 部署的环境变量。
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# 这份文件只给 docker-compose.yml 用，与仓库根目录的 .env（本地开发用）不是一回事。
# .env 已在 .gitignore 里，不会被提交。

# ---- 域名 ----
# 两个域名都要提前解析到这台机器，Caddy 才能申请到证书。
# 站点域名就是用户访问的地址；对象存储域名只承载图片直传/直取。
SITE_DOMAIN=travel.example.com
MINIO_DOMAIN=img.example.com

# ---- 密码与凭证（务必全部改掉）----
# ⚠️ POSTGRES_PASSWORD 会被拼进 DATABASE_URL，只用字母数字最省心；
#    非要带特殊字符就得自己做 URL 编码，否则连接串会被切错。
POSTGRES_PASSWORD=change-me-postgres

# MinIO 的根账号密码，同时也是后端调对象存储用的 S3 凭证
S3_ACCESS_KEY=travelblog
S3_SECRET_KEY=change-me-minio-secret
