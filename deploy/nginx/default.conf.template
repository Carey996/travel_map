# 前端容器的 nginx 配置（模板）。
#
# 官方 nginx 镜像会自动对 /etc/nginx/templates/*.template 做 envsubst 后写到
# /etc/nginx/conf.d/ 下，因此上游地址可以用环境变量注入：
#   Kubernetes：API_UPSTREAM=travel-blog-api:8000（Service DNS）
#   本地 podman play kube：API_UPSTREAM=127.0.0.1:8000（同 Pod 内共享网络）
#
# 关键点：**把 /api 与 /healthz 反代到后端**，让浏览器视角下前后端同源。
# 收益有两个：会话 Cookie 的 SameSite=Lax 正常工作，不必放宽到 None；
# 也不需要给前端配 CORS 白名单里的额外来源。
upstream api_upstream {
    server ${API_UPSTREAM};
}

server {
    # 监听 8080 而非 80：这样容器可以完全以非 root 运行
    listen 8080;
    server_name _;

    # 不在响应头里暴露 nginx 版本
    server_tokens off;

    # ---------------------------------------------------------------------
    # 安全响应头
    #
    # 注意 nginx 的继承规则：子块（location）里只要出现一条 add_header，
    # 就不再继承 server 级的 add_header。因此下面的 location 一律不用
    # add_header（缓存改用 expires 指令），安全头统一由这里下发，避免漏头。
    # ---------------------------------------------------------------------
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # CSP 各条的理由：
    #   script-src 'self'        构建产物只有同源外链脚本，没有内联 <script>
    #   style-src  'unsafe-inline' Element Plus / Leaflet 会写行内 style 属性
    #   img-src    data: blob:    浏览器端 Canvas 生成的缩略图；https 为高德瓦片与图床
    #   img-src    http:          单 Pod / 本地验证时对象存储是 http 明文地址（HTTPS 下会被混合内容拦截）
    #   connect-src https: http:  预签名直传直取、SSE 之类的跨源请求
    # 若日后加了新的外部源，浏览器 Console 会给出被拦截的 URL，按提示追加即可。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' https: http:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    root /usr/share/nginx/html;
    index index.html;

    # SPA 路由：找不到实体文件就交回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 上传的是元数据而非文件本体，但预签名签发可能稍慢，给足超时
        proxy_read_timeout 60s;
    }

    location /healthz {
        proxy_pass http://api_upstream;
        proxy_set_header Host $host;
    }

    # 静态资源长缓存；index.html 不缓存，保证发版即时生效。
    # 这里只写 expires（不写 add_header）：既避免 Cache-Control 出现两条，
    # 也保住 server 级安全头的继承——hashed 文件名已经足够，不再叠加 immutable。
    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|svg|webp|ico)$ {
        expires 30d;
    }

    location = /index.html {
        expires -1;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
